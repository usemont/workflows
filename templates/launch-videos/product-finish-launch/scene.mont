 }
 play(time: Number) {
  let travel = time / (time + 2)
  spatial.transform({nodeId:"camera:main",translation:[3.2 - 4 * travel, 5.8 + 2.5 * travel, 7.8 + 7 * travel]})
  spatial.lookAt({nodeId:"camera:main",targetNodeId:"focus"})
  spatial.transform({nodeId:"title",translation:[-3.8,3.35 + 0.7 * travel,-0.3]})
  spatial.transform({nodeId:"subtitle",translation:[-0.6,3.45 + 0.7 * travel,-0.3]})
  let spread = motion.spring(time - 1.5, 3.5, 3.2)
  spatial.transform({nodeId:"left",translation:[-2.5 - 0.5 * spread,1.4,-0.9],rotationEulerDegrees:[0,-12,0]})
  spatial.transform({nodeId:"right",translation:[2.5 + 0.5 * spread,1.4,-0.35],rotationEulerDegrees:[0,12,0]})
 }
}
