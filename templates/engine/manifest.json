  "story":{"entity":"{label:1..30 chars,icon:required except conclusion,kind?:thing|actor|conclusion,who?:up to 26 chars,sub?:up to 40 chars,brand?}","maxEntities":14,"maxCards":5,"maxBeats":8,"relations":["rule","example","also","except","contrast","because","then","state","so"],"states":["unknown","risk","blocked","ok","focus","muted","none"],"beatFields":["rel","at","on?","of?","to?","by?","fixes?","into?","set?","setAt?","subAt?"],"args":{"rule":"on:id or id[]; first only","example":"of:board id,to:fresh thing id","also":"of:board id,to:fresh thing id[]","except":"of,to","contrast":"of,to","because":"of,to; reason before source","then":"to:fresh thing id","state":"set:board-id to state map","so":"by?:actor,fixes?:board-id[],into?:conclusion"},"timingSeconds":{"flip":0.62,"move":0.85,"hop":0.3}},
