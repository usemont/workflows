{
  "schemaVersion": 1,
  "id": "markdown-native-explainer",
  "revision": "1",
  "inputs": {
    "markdown": {
      "valueType": "string",
      "required": true
    },
    "policy": {
      "valueType": "object",
      "required": false,
      "default": {
        "$json": "policy.json"
      }
    },
    "theme": {
      "valueType": "string",
      "required": false,
      "default": "daylight"
    },
    "brands": {
      "valueType": "object",
      "required": false,
      "default": {}
    },
    "workspace": {
      "valueType": "string",
      "required": false,
      "default": "output/example.mont-workspace"
    },
    "output": {
      "valueType": "string",
      "required": false,
      "default": "output/example.mp4"
    },
    "width": {
      "valueType": "number",
      "required": false,
      "default": 1920
    },
    "height": {
      "valueType": "number",
      "required": false,
      "default": 1080
    },
    "fps": {
      "valueType": "number",
      "required": false,
      "default": 30
    },
    "clef": {
      "valueType": "string",
      "required": false,
      "default": "clef"
    },
    "haiku": {
      "valueType": "string",
      "required": false,
      "default": "haiku"
    },
    "voice": {
      "valueType": "string",
      "required": false,
      "default": "voice"
    },
    "transcription": {
      "valueType": "string",
      "required": false,
      "default": "transcription"
    },
    "fill": {
      "valueType": "string",
      "required": false,
      "default": "haiku"
    }
  },
